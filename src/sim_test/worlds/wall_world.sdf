<?xml version="1.0"?>
<!-- A flat floor, one wall 3 m ahead, and a small two-wheeled robot with a front lidar. -->
<sdf version="1.9">
  <world name="wall_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wall face is at x = 2.9 m. -->
    <model name="wall">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 4 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 4 1</size></box></geometry>
          <material><diffuse>0.8 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bot">
      <pose>0 0 0 0 0 0</pose>

      <link name="chassis">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.03</iyy><izz>0.04</izz></inertia>
        </inertial>
        <collision name="body">
          <geometry><box><size>0.4 0.3 0.1</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>0.4 0.3 0.1</size></box></geometry>
          <material><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
        <!-- Front caster: a sphere with no friction so it slides. -->
        <collision name="caster">
          <pose>0.15 0 -0.06 0 0 0</pose>
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="caster">
          <pose>0.15 0 -0.06 0 0 0</pose>
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
        </visual>

        <sensor name="front_lidar" type="gpu_lidar">
          <pose>0.18 0 0.08 0 0 0</pose>
          <topic>scan</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <lidar>
            <scan>
              <horizontal>
                <samples>61</samples>
                <min_angle>-0.6</min_angle>
                <max_angle>0.6</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.12</min>
              <max>10.0</max>
            </range>
          </lidar>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>-0.05 0.175 0.08 -1.5707 0 0</pose>
        <inertial>
          <mass>0.3</mass>
          <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>-0.05 -0.175 0.08 -1.5707 0 0</pose>
        <inertial>
          <mass>0.3</mass>
          <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <!-- Turns /cmd_vel (forward speed + turn rate) into wheel speeds and publishes /odom. -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.35</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>chassis</child_frame_id>
        <odom_publisher_frequency>20</odom_publisher_frequency>
      </plugin>

      <!-- The true pose from the simulator. Wheel odometry above drifts when the wheels slip,
           so tests judge the robot on this one. -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_topic>ground_truth</odom_topic>
        <odom_frame>world</odom_frame>
        <robot_base_frame>chassis</robot_base_frame>
        <odom_publish_frequency>20</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </model>
  </world>
</sdf>
